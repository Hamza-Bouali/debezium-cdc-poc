
{
  "name": "sink-connector",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",

    "connection.url": "jdbc:postgresql://${env:DB_TARGET_HOST}:${env:DB_TARGET_PORT}/${env:DB_TARGET_NAME}",
    "connection.username": "${env:DB_TARGET_USER}",
    "connection.password": "${env:DB_TARGET_PASSWORD}",

    "topics.regex": "cdc\\.public\\..*",

    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "^cdc\\.public\\.(.*)$",
    "transforms.route.replacement": "$1",

    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "schema.evolution": "basic"
  }
}
